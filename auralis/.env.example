# Auralis environment configuration.
# Copy to `.env` for reference; the application reads the process environment,
# so export these or use your own loader. Nothing here is required for local
# development — every value below has a safe default.

# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
AURALIS_HOST=127.0.0.1
AURALIS_PORT=5175

# ─── Storage ──────────────────────────────────────────────────────────────────
# SQLite file. The directory is created automatically.
AURALIS_DATABASE_PATH=./data/auralis.db

# ─── Secrets (REQUIRED in production) ─────────────────────────────────────────
# 32 bytes, base64 encoded. Generate with: openssl rand -base64 32
# Used to encrypt connector credentials at rest. Losing it makes stored
# connector credentials unreadable (connectors must be reconnected).
# AURALIS_SECRET_KEY=

# At least 32 characters. Signs the anonymous workspace session cookie.
# Generate with: openssl rand -hex 32
# AURALIS_SESSION_SECRET=

# ─── Private instance (optional) ──────────────────────────────────────────────
# Set this and the whole instance is closed behind one password: every request
# except /health needs it. Intended for a personal deployment on a public
# hostname, where an unlisted address is not access control.
# Minimum 8 characters. Unset means no gate at all.
# Changing it signs everyone out, because the cookie is derived from it.
# AURALIS_ACCESS_PASSWORD=

# ─── Browser client ───────────────────────────────────────────────────────────
AURALIS_CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
# Serve the built client from the API process (single-origin deployment).
AURALIS_SERVE_WEB=false
AURALIS_WEB_DIST=../web/dist

# ─── Local demonstration ──────────────────────────────────────────────────────
# Allows the egress layer to reach loopback and private addresses so the
# bundled fixture origin can be searched. REFUSED when NODE_ENV=production.
AURALIS_ALLOW_PRIVATE_EGRESS=true
# Allows plain http targets. Needed for the local fixture origin.
AURALIS_ALLOW_INSECURE_HTTP=true
AURALIS_FIXTURE_ORIGIN_PORT=5176
AURALIS_FIXTURE_DIR=./data/fixtures

# ─── Observability and privacy ────────────────────────────────────────────────
AURALIS_LOG_LEVEL=info
# OFF by default. Turning this on writes the text of user searches to the log.
AURALIS_LOG_QUERY_TEXT=false

# ─── Limits ───────────────────────────────────────────────────────────────────
AURALIS_RATE_LIMIT_SEARCHES_PER_MINUTE=20
AURALIS_RATE_LIMIT_DOWNLOADS_PER_MINUTE=40
AURALIS_SEARCH_RETENTION_DAYS=30

# ─── Optional shared cache ────────────────────────────────────────────────────
# Not required. When absent, an in-process bounded cache is used.
# AURALIS_REDIS_URL=redis://127.0.0.1:6379
