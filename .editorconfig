# Consistent formatting across editors and machines.
# https://editorconfig.org — supported natively by VS Code, Xcode and JetBrains.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.md]
# Two trailing spaces are a hard line break in Markdown; do not strip them.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
