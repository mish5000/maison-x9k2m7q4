# Copy to .env for local runs. Names only — never commit real values.
ANTHROPIC_API_KEY=
# Preferred login: value of the substack.sid cookie from newsletter.semianalysis.com
SUBSTACK_COOKIE=
# Alternative login (needs a password set on Substack)
SUBSTACK_EMAIL=
SUBSTACK_PASSWORD=
# Encrypts data/briefs.json; enter the same phrase once in the app
BRIEF_PASSPHRASE=
# Optional phone notifications via https://ntfy.sh
NTFY_TOPIC=
# Optional overrides
SUMMARY_MODEL=claude-opus-5
MAX_NEW_POSTS=5
APP_URL=https://mish5000.github.io/maison-x9k2m7q4/substack-brief/
